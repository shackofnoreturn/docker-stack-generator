{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run application",
			"type": "shell",
			"command": "python",
			"args": [
				"${workspaceFolder}/run.py"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Install prerequisites",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"pip",
				"install",
				"-e",
				"."
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		}
	]
}

